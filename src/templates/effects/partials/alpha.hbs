<div class="form-group">
  <label for="{{@root.rootId}}-alpha">{{localize
      "DEATH-EFFECTS.EFFECTS.COMMON.ALPHA.LABEL"
    }}</label>
  <range-picker
    id="{{@root.rootId}}-alpha"
    name="alpha"
    min="0"
    max="1"
    step="any"
    value="{{alpha}}"
  ></range-picker>
  <p class="hint">{{localize "DEATH-EFFECTS.EFFECTS.COMMON.ALPHA.HINT"}}</p>
</div>